{
  "name": "dawat-e-islami-ai-backend",
  "version": "1.0.0",
  "description": "Production-ready backend and data seeding pipeline for Dawat-e-Islami AI Assistant using Node.js, Express, MongoDB, and @google/genai",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedKnowledge.js",
    "test": "node scripts/testSuite.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "keywords": [
    "dawat-e-islami",
    "gemini",
    "ai-assistant",
    "mern",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "Dawat-e-Islami AI Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
